---
import { getCollection } from 'astro:content';
import CollectionPage from '../../components/CollectionPage.astro';
import { byNewest, publicOnly, withBase } from '../../utils/site';
const items = byNewest(publicOnly(await getCollection('process')));
---
<CollectionPage title="Process / Timeline" eyebrow="01 / Evidence of effort" description="A dated record of research, experiments, decisions, revisions and meetings. The timeline keeps both visible outcomes and the work that led to them." collection="process" items={items} categoryField="type">
  <section class="timeline-overview">
    <div class="shell">
      <div class="index-line"><span>Proposal version history</span><span>Sep–Oct 2026</span></div>
      <ol class="milestone-list">
        <li><time datetime="2026-09-27">27 Sep 2026</time><a href={withBase('process/2026-09-27-proposal-v1-initial-concept-draft/')}>Proposal V1 completed</a></li>
        <li><time datetime="2026-10-07">07 Oct 2026</time><a href={withBase('process/2026-10-07-supervisor-follow-up/')}>Follow-up and supervisor communication</a></li>
        <li><time datetime="2026-10-22">22 Oct 2026</time><a href={withBase('process/2026-10-22-registration-and-proposal-review/')}>Registration draft and critique of V1</a></li>
        <li><time datetime="2026-10-26">26 Oct 2026</time><a href={withBase('process/2026-10-26-proposal-v2-supervisor-meeting-draft/')}>Proposal V2 supervisor meeting draft</a></li>
        <li><time datetime="2026-10-26">26 Oct 2026</time><a href={withBase('process/2026-10-26-supervisor-meeting/')}>Supervisor meeting feedback</a></li>
        <li><time datetime="2026-10-28">After 26 Oct</time><span><a href={withBase('research/')}>Research</a> and <a href={withBase('experiments/')}>experiments</a> continue from the revised direction</span></li>
      </ol>
    </div>
  </section>
</CollectionPage>
