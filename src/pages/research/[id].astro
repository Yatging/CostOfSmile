---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
export async function getStaticPaths() {
  const entries = (await getCollection('research')).filter((entry) => !entry.data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'research'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<EntryPage title={entry.data.title} summary={entry.data.summary} date={entry.data.date} label={entry.data.category} collection="research" tags={entry.data.tags} cover={entry.data.cover} externalUrl={entry.data.external_url} videoUrl={entry.data.video_url} details={[["Creator", entry.data.creator], ["Year", entry.data.year], ["Citation", entry.data.citation]]}><Content /></EntryPage>
