---
import { formatDate, withBase } from '../utils/site';

interface Props {
  id: string;
  collection: string;
  title: string;
  summary: string;
  date: Date;
  label: string;
  tags?: string[];
  cover?: string;
}

const { id, collection, title, summary, date, label, tags = [], cover } = Astro.props;
const safeCover = cover?.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${cover.replace(/^\/CostOfSmile/, '')}` : cover;
---

<article class="card" data-category={label}>
  {safeCover ? <img class="card-media" src={safeCover} alt="" loading="lazy" /> : <div class="card-placeholder" aria-hidden="true"></div>}
  <div class="card-body">
    <div class="card-meta"><span>{label}</span><time datetime={date.toISOString()}>{formatDate(date)}</time></div>
    <h2>{title}</h2>
    <p>{summary}</p>
    {tags.length > 0 && <div class="tag-list">{tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}</div>}
    <a class="card-link" href={withBase(`${collection}/${id}/`)} aria-label={`Read ${title}`}>Open record</a>
  </div>
</article>
