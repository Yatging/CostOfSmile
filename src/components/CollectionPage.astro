---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from './EntryCard.astro';

interface Item {
  id: string;
  data: Record<string, any>;
}

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  collection: string;
  items: Item[];
  categoryField: string;
  emptyText?: string;
}

const { title, eyebrow, description, collection, items, categoryField, emptyText = 'No public records yet.' } = Astro.props;
const categories = [...new Set(items.map((item) => String(item.data[categoryField])))];
---

<BaseLayout title={`${title} — Cost of Smile`} description={description}>
  <header class="page-hero shell">
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p class="page-deck">{description}</p>
  </header>
  <slot />
  <section class="section">
    <div class="shell">
      <div class="index-line"><span>Archive index</span><span>{String(items.length).padStart(2, '0')} records</span></div>
      {categories.length > 1 && (
        <div class="filter-bar" aria-label="Filter records">
          <button class="filter-button" type="button" data-filter="All" aria-pressed="true">All</button>
          {categories.map((category) => <button class="filter-button" type="button" data-filter={category} aria-pressed="false">{category}</button>)}
        </div>
      )}
      {items.length > 0 ? (
        <div class="card-grid" id="record-grid">
          {items.map((item) => (
            <EntryCard
              id={item.id}
              collection={collection}
              title={item.data.title}
              summary={item.data.summary}
              date={item.data.date}
              label={item.data[categoryField]}
              tags={item.data.tags}
              cover={item.data.cover}
            />
          ))}
        </div>
      ) : <p class="notice">{emptyText}</p>}
    </div>
  </section>
  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        filterButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
        cards.forEach((card) => { card.hidden = filter !== 'All' && card.dataset.category !== filter; });
      });
    });
  </script>
</BaseLayout>
